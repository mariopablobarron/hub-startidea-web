// Plataforma HUB Startidea — schema completo
// Ver docs/PLATFORM-ROADMAP.md para contexto y decisiones.
//
// Convenciones:
// - cuid() para IDs (compatible Coolify y otras apps Startidea)
// - createdAt/updatedAt en todas las tablas relevantes
// - Soft delete NO (preferimos auditoría). Si hace falta, se añade luego.
// - Cantidades monetarias en céntimos (Int), no decimales

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USUARIOS Y ROLES
// ============================================================

enum Role {
  VISITOR // sin login o cuenta básica
  CLIENT // cliente puntual: reserva con pago, sin descuento
  MEMBER // coworker activo, plaza fija o flex
  COLLABORATOR // red Startidea: -20% en reservas
  ADMIN // Mario y equipo
}

enum MembershipType {
  COWORKER_FIXED // plaza fija mensual
  COWORKER_FLEX // pase flex (X días/mes)
  OFFICE_PRIVATE // office privado
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  emailVerified   DateTime?
  name            String?
  image           String?
  phone           String?
  passwordHash    String? // null si solo usa magic-link
  role            Role            @default(VISITOR)
  membershipType  MembershipType?
  membershipUntil DateTime?
  // Descuento personalizado asignable por admin, independiente del rol.
  // Se aplica el MÁS ventajoso entre rol y este; no se acumulan
  // (ver lib/bookings/pricing.ts). NULL = sin descuento personal.
  discountKind    DiscountKind?
  discountValue   Int? // PERCENT: 0-100 · FIXED: céntimos
  bio             String?         @db.Text
  // Visibilidad pública del usuario en /comunidad
  publicProfile   Boolean         @default(false)

  bookings           Booking[]
  payments           Payment[]
  bonds              PrepaidBond[]
  eventsOrganized    Event[]             @relation("EventOrganizer")
  eventRegistrations EventRegistration[]
  topics             Topic[]
  posts              Post[]
  reactions          Reaction[]
  sessions           Session[]
  accounts           Account[]
  verificationTokens VerificationToken[]
  keyHolders         KeyHolder[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  @@index([role])
}

// NextAuth v5 — modelos requeridos por el adapter Prisma
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  // Mantenemos relación opcional con User si el email coincide (no obligatoria)
  user       User?    @relation(fields: [identifier], references: [email])

  @@unique([identifier, token])
}

// ============================================================
// RESERVAS Y PAGOS
// ============================================================

enum BookingStatus {
  PENDING // creada, espera aprobación o pago
  CONFIRMED // confirmada
  CANCELLED // cancelada por usuario o admin
  COMPLETED // pasó OK
  NO_SHOW // no apareció
}

model Booking {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  // referencia a content.json (cc33, serendipia, socrates, etc.) — no FK porque
  // el catálogo de salas vive en git, no en BD (es estable y bajo cambio)
  roomSlug   String
  startsAt   DateTime
  endsAt     DateTime
  attendees  Int?
  purpose    String?       @db.Text // "Formación equipo X", evento, etc.
  status     BookingStatus @default(PENDING)
  totalCents Int           @default(0)
  paymentId  String?
  payment    Payment?      @relation(fields: [paymentId], references: [id])
  bondId     String?
  bond       PrepaidBond?  @relation(fields: [bondId], references: [id])
  notes      String?       @db.Text // notas del cliente
  adminNotes String?       @db.Text // notas del admin (internas)
  // Snapshot del código de cupón aplicado (se guarda aunque el cupón
  // se borre/edite después — auditoría del descuento concedido).
  couponCode String?

  // Feedback post-COMPLETED (opcional). Solo se crea cuando el cron
  // detecta la reserva como COMPLETED + envía email pidiendo feedback.
  feedback Feedback?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Validación de overlaps se hace en server action (no en exclusion constraint
  // de Postgres — más simple y portable). Índices para query eficiente.
  @@index([roomSlug, startsAt, endsAt])
  @@index([userId, startsAt])
  @@index([status, startsAt])
}

// Feedback humano post-reserva. Filosofía Startidea: NO escala 1-10,
// solo una pregunta abierta — "¿Cómo te sentiste trabajando aquí?".
// El email lleva un link /feedback/[token] (sin login) para responder.
// Marca relacional Honestidad: queremos texto humano, no métrica fría.
model Feedback {
  id          String    @id @default(cuid())
  bookingId   String    @unique
  booking     Booking   @relation(fields: [bookingId], references: [id])
  // Token público para acceder al form sin login. Se incluye en el
  // email enviado al user — solo quien recibe el email puede responder.
  token       String    @unique @default(cuid())
  // Respuesta libre del user. Null hasta que responda.
  text        String?   @db.Text
  // Cuándo se envió el email pidiendo feedback (un solo intento).
  sentAt      DateTime  @default(now())
  // Cuándo respondió (null si no ha respondido todavía).
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  // Para query de "respondidos recientemente" en /admin/feedback
  @@index([respondedAt])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  STRIPE // Stripe Checkout (tarjeta) — confirma webhook
  BANK_TRANSFER // Transferencia bancaria — admin confirma manualmente
}

// Tipo de descuento, compartido por User (descuento personal) y Coupon.
enum DiscountKind {
  PERCENT // value = 0-100 (porcentaje sobre base imponible)
  FIXED // value = céntimos a descontar de la base imponible
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id])
  amountCents           Int
  currency              String        @default("EUR")
  status                PaymentStatus @default(PENDING)
  method                PaymentMethod @default(STRIPE)
  description           String?
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?       @unique
  bookings              Booking[]
  bondPurchase          PrepaidBond?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

enum BondType {
  ROOM_HOURS_10
  ROOM_HOURS_50
  PODCAST_SESSIONS_5
  COWORKING_DAYS_10
}

model PrepaidBond {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  type       BondType
  hoursTotal Int
  hoursUsed  Int       @default(0)
  expiresAt  DateTime?
  paymentId  String?   @unique
  payment    Payment?  @relation(fields: [paymentId], references: [id])
  bookings   Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Catálogo de tarifas — editable desde admin. Cada sala puede tener
// múltiples tarifas (hora, media jornada, jornada completa, evento) y
// diferentes precios según rol (CLIENT, MEMBER, COLLABORATOR).
enum PricingUnit {
  PER_HOUR
  HALF_DAY
  FULL_DAY
  EVENT
  PER_SESSION // podcast por sesión
  PER_DAY // coworking por día
}

model Pricing {
  id                String      @id @default(cuid())
  roomSlug          String // referencia content.json
  unit              PricingUnit
  // Precios en céntimos por rol. NULL = no aplica para ese rol.
  clientCents       Int?
  memberCents       Int?
  collaboratorCents Int?
  // Notas internas opcionales (ej. "incluye proyector + agua")
  notes             String?     @db.Text
  active            Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomSlug, unit])
  @@index([roomSlug, active])
}

// Cupones / códigos promocionales — gestionables desde /admin/cupones.
// El cliente teclea el código al reservar; se valida en server action.
// El descuento puede ser % (0-100) o importe fijo en céntimos.
model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique // normalizado a MAYÚSCULAS
  kind           DiscountKind
  value          Int // PERCENT: 0-100 · FIXED: céntimos
  active         Boolean      @default(true)
  expiresAt      DateTime? // null = sin caducidad
  maxRedemptions Int? // null = ilimitado
  redemptions    Int          @default(0)
  // Restricción opcional a una sala concreta (null = aplica a todas)
  roomSlug       String?
  notes          String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// ============================================================
// EVENTOS
// ============================================================

model Event {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  description      String              @db.Text
  startsAt         DateTime
  endsAt           DateTime
  // Ubicación: sala del HUB o texto libre (eventos externos del ecosistema)
  roomSlug         String?
  externalLocation String? // para eventos fuera del HUB
  cover            String? // path a /public/images/events/...
  isPublic         Boolean             @default(true)
  // Si es false, no aparece en /eventos hasta que se publica
  published        Boolean             @default(false)
  capacity         Int?
  organizerId      String
  organizer        User                @relation("EventOrganizer", fields: [organizerId], references: [id])
  registrations    EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt, published])
  @@index([slug])
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
  WAITLIST
}

model EventRegistration {
  id      String             @id @default(cuid())
  eventId String
  event   Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // userId opcional: permitimos invitados externos sin cuenta (registro guest)
  userId  String?
  user    User?              @relation(fields: [userId], references: [id])
  email   String
  name    String?
  phone   String?
  status  RegistrationStatus @default(REGISTERED)
  notes   String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Una persona (por email) solo se registra una vez al mismo evento
  @@unique([eventId, email])
  @@index([userId])
}

// ============================================================
// FORO
// ============================================================

enum TopicCategory {
  GENERAL
  ANUNCIOS
  PROYECTOS
  EVENTOS
  COWORKING
  AYUDA
}

model Topic {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  body           String        @db.Text
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  category       TopicCategory @default(GENERAL)
  pinned         Boolean       @default(false)
  locked         Boolean       @default(false)
  views          Int           @default(0)
  // Última actividad del hilo: max(createdAt, último post) — denormalizado
  // para sort eficiente sin agregar la tabla Post en cada query.
  lastActivityAt DateTime      @default(now())
  posts          Post[]
  reactions      Reaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, lastActivityAt])
  @@index([pinned, lastActivityAt])
}

model Post {
  id        String     @id @default(cuid())
  topicId   String
  topic     Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id])
  body      String     @db.Text
  reactions Reaction[]
  // Marcado como respuesta aceptada (útil en categoría AYUDA)
  isAnswer  Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId, createdAt])
}

enum ReactionType {
  LIKE
  CELEBRATE
  IDEA
  THANK
}

model Reaction {
  id      String       @id @default(cuid())
  userId  String
  user    User         @relation(fields: [userId], references: [id])
  topicId String?
  topic   Topic?       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  postId  String?
  post    Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  type    ReactionType

  createdAt DateTime @default(now())

  // Un usuario solo puede reaccionar una vez al mismo item con el mismo type
  @@unique([userId, topicId, postId, type])
}

// ============================================================
// LOGS / AUDITORÍA (mínimo — extender después)
// ============================================================

model AuditLog {
  id         String  @id @default(cuid())
  actorId    String? // userId del que hizo la acción
  actorEmail String? // copia denormalizada por si se borra el user
  action     String // "booking.approved", "user.role_changed", etc.
  target     String? // id del recurso afectado
  metadata   Json? // datos adicionales

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ============================================================
// CONTROL DE ACCESO FÍSICO AL ESPACIO
// ============================================================

enum AccessType {
  PHYSICAL_KEY // llave física del local
  ALARM_CODE // código de la alarma
  ACCESS_CARD // tarjeta/llavero de proximidad
  GARAGE_REMOTE // mando del garaje/portal
  BUILDING_KEY // llave del portal del edificio
  OTHER // otro (detallar en notas)
}

enum KeyHolderStatus {
  ACTIVE // tiene el acceso ahora mismo
  REVOKED // se le retiró (devolvió llave, baja, etc.)
}

// Padrón de tenedores de llave / acceso al HUB (C/ Conde Cifuentes 33).
// Registro administrativo para SABER QUIÉN PUEDE ENTRAR y con qué medio.
// No es cerradura electrónica — es el control documental: quién, qué
// tipo de acceso, desde cuándo, quién lo autorizó, y baja cuando devuelve.
// Nunca se borra una fila: se marca REVOKED (auditoría e histórico).
model KeyHolder {
  id     String  @id @default(cuid())
  // Datos de la persona. Puede ser un User del HUB (coworker/staff) o
  // alguien externo sin cuenta (limpieza, mantenimiento, propietario).
  name   String
  email  String?
  phone  String?
  // Link opcional a User si es miembro del HUB (no obligatorio).
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  accessType AccessType @default(PHYSICAL_KEY)
  // Identificador físico opcional: nº de copia grabado en la llave,
  // últimos dígitos del código, nº de tarjeta. Para inventario.
  identifier String?
  // Rol / motivo del acceso: "Coworker fijo", "Limpieza", "Mantenimiento",
  // "Propietario", "Staff Startidea"...
  role       String?
  notes      String?    @db.Text

  status       KeyHolderStatus @default(ACTIVE)
  grantedAt    DateTime        @default(now())
  // Quién autorizó el alta (auditoría).
  grantedBy    String? // email del admin
  revokedAt    DateTime?
  revokedBy    String? // email del admin que dio de baja
  revokeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([accessType, status])
}

// ============================================================
// CÁPSULA DEL TIEMPO — GRABACIONES
// ============================================================

enum RecordingKind {
  AUDIO // solo mezcla de audio (voz invitado + entrevistador + TTS + ambiente)
  VIDEO // escena 360 + audio
}

// Grabación de una sesión de la experiencia Cápsula del Tiempo. El archivo
// real NO va a git (pesa) ni a /public (privado): vive en un volumen del VPS
// (RECORDINGS_DIR) y se sirve por endpoint autenticado. Aquí solo metadatos.
// Sesiones íntimas: nunca públicas, solo accesibles desde el admin.
model Recording {
  id          String        @id @default(cuid())
  sala        String // código de sala de la Cápsula (p.ej. "estudio")
  kind        RecordingKind @default(VIDEO)
  mime        String // p.ej. "video/webm"
  filename    String // nombre del archivo en disco (no la ruta completa)
  sizeBytes   Int // tamaño en bytes (límite de subida < 2 GB → Int basta)
  durationSec Int? // duración aproximada si el cliente la reporta
  note        String?       @db.Text // nota opcional del entrevistador
  createdAt   DateTime      @default(now())

  @@index([sala, createdAt])
}
